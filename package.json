{
  "name": "kiroween-chaos",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Chaos engineering for AI agents, played as a haunted house. Kiroween Chaos crashes and curses your bots, grades how they survive, and shows the exact fix. One engine, three apps: Node and Python.",
  "license": "MIT",
  "repository": { "type": "git", "url": "git+https://github.com/kakoritz/Kiroween-Chaos.git" },
  "engines": { "node": ">=20" },
  "workspaces": ["packages/*", "apps/*"],
  "scripts": {
    "mock": "node tools/run-ts.mjs packages/core/src/bin/mock.ts",
    "live": "node tools/run-ts.mjs packages/core/src/bin/live.ts",
    "ui:dev": "npm run dev -w @haunt/arena-ui",
    "ui:build": "npm run build -w @haunt/arena-ui",
    "build": "node tools/build.mjs",
    "build:browser": "node tools/build-browser.mjs",
    "build:hosted": "npm run ui:build && node tools/build-hosted.mjs",
    "serve:hosted": "node tools/serve-hosted.mjs",
    "check:hosted": "node tools/hosted-check.mjs --shots=docs/proof/hosted",
    "record:hosted": "node tools/record-hosted.mjs",
    "build:bots": "node tools/build-bots.mjs",
    "demo": "node tools/demo.mjs",
    "test": "vitest run",
    "test:contract": "vitest run --config vitest.contract.config.ts",
    "validate:events": "node tools/run-ts.mjs tools/validate-events.ts",
    "validate:live": "node tools/validate-live.mjs",
    "trace": "node tools/run-ts.mjs tools/trace.ts",
    "review": "node tools/run-ts.mjs tools/haunt-review.ts",
    "make:fixtures": "node tools/run-ts.mjs tools/make-fixtures.ts",
    "make:outcomes": "node tools/run-ts.mjs tools/make-outcomes.ts",
    "typecheck": "tsc --noEmit",
    "verify": "node tools/verify.mjs",
    "packs:embed": "node tools/embed-packs.mjs",
    "apps:embed": "node tools/embed-apps.mjs",
    "haunt": "node tools/run-ts.mjs packages/core/src/bin/haunt.ts",
    "own-bot": "node tools/run-ts.mjs packages/core/src/bin/own-bot.ts",
    "block:add": "node tools/run-ts.mjs packages/core/src/bin/block-add.ts",
    "chain:grade": "node tools/run-ts.mjs packages/core/src/bin/chain-grade.ts",
    "flow:import": "node tools/run-ts.mjs packages/core/src/bin/flow-import.ts",
    "submit:check": "node tools/submit-check.mjs",
    "bot:new": "node tools/run-ts.mjs packages/core/src/bin/bot-new.ts",
    "build:crew-app": "node tools/build-crew-app.mjs",
    "blocks:doc": "node tools/run-ts.mjs packages/core/src/bin/block-doc.ts",
    "judge:check": "node tools/run-ts.mjs tools/judge-check.ts",
    "fresh-clone": "node tools/fresh-clone.mjs",
    "e2e": "node tools/e2e.mjs"
  },
  "devDependencies": {
    "@types/node": "20.19.43",
    "ajv": "8.20.0",
    "esbuild": "0.28.2",
    "fast-check": "4.10.3",
    "typescript": "5.9.3",
    "vitest": "3.2.7"
  }
}
