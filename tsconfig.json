{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "types": ["node"],
    "baseUrl": ".",
    "paths": { "@haunt/shared": ["packages/haunt/src/shared/index.ts"], "@haunt/sdk": ["packages/haunt/src/sdk/index.ts"], "@haunt/bot": ["packages/haunt/src/bot/index.ts"] }
  },
  "include": ["packages/*/src", "packages/*/test", "apps/*/src", "apps/*/test", "tools/*.ts", "vitest*.config.ts"]
}
