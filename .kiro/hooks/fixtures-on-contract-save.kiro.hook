{
    "enabled":  true,
    "name":  "Validate fixtures on contract save",
    "description":  "Validate event fixtures against the schema when a contract file is saved.",
    "version":  "1",
    "when":  {
                 "type":  "fileEdited",
                 "patterns":  [
                                  "contract/**",
                                  "fixtures/**"
                              ]
             },
    "then":  {
                 "type":  "runCommand",
                 "command":  "npm run validate:events"
             }
}
